@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #0e0e0e;
        color: #fff;
        font-family: 'Segoe UI', sans-serif;
    }

    .sidebar {
        width: 260px;
        background-color: #1a1a1a;
        min-height: 100vh;
    }

        .sidebar .nav-link {
            color: #bbb;
            padding: 12px;
            font-weight: 500;
            transition: 0.3s;
        }

            .sidebar .nav-link:hover,
            .sidebar .nav-link.active {
                background-color: #2a2a2a;
                color: #fff;
                border-radius: 6px;
            }

    .main-content {
        background-color: #141414;
        padding: 40px;
    }

    .card {
        background-color: #202020;
        color: #fff;
        border: none;
        border-radius: 12px;
    }

    .card-body h4 {
        font-size: 1.5rem;
    }

    .table thead {
        background-color: #2c2c2c;
    }

    .table tbody tr:hover {
        background-color: #1e1e1e;
    }

    .btn-custom {
        background-color: #343a40;
        color: #fff;
        border: none;
    }

        .btn-custom:hover {
            background-color: #495057;
            color: #fff;
        }
</style>

<div class="d-flex">
    <!-- Sidebar -->
    <div class="sidebar p-4">
        <h4 class="text-white text-center mb-4">AutoAppHoho</h4>
        <ul class="nav flex-column">
            <li class="nav-item mb-2">
                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link" asp-controller="Car" asp-action="Index">Auto's</a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link" asp-controller="Booking" asp-action="Index">Boekingen</a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link" asp-controller="UserManagement" asp-action="Index">Gebruikers</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Invoice" asp-action="Index">Facturen</a>
            </li>
        </ul>
    </div>

    <!-- Main Content -->
    <div class="flex-fill main-content">
        <h2 class="mb-5">Beheerder Dashboard</h2>

        <!-- Stats Cards -->
        <div class="row mb-5">
            <div class="col-md-3">
                <div class="card p-3">
                    <div class="card-body">
                        <h6 class="text-muted">Totaal Auto's</h6>
                        <h4>@ViewBag.TotalCars</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-3">
                    <div class="card-body">
                        <h6 class="text-muted">Totaal Boekingen</h6>
                        <h4>@ViewBag.TotalBookings</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-3">
                    <div class="card-body">
                        <h6 class="text-muted">Totaal Beheerders</h6>
                        <h4>@ViewBag.TotalAdmins</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-3">
                    <div class="card-body">
                        <h6 class="text-muted">Totaal Facturen</h6>
                        <h4>@ViewBag.TotalInvoices</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- Auto Tabel + CRUD -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Auto Advertenties</h5>
            <a asp-controller="Car" asp-action="Create" class="btn btn-custom">+ Nieuwe Auto</a>
        </div>

        <div class="table-responsive mb-5">
            <table class="table table-dark table-striped table-hover">
                <thead>
                    <tr>
                        <th>Naam</th>
                        <th>Brandstof</th>
                        <th>Categorie</th>
                        <th>Prijs</th>
                        <th>Acties</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var car in ViewBag.RecentCars)
                    {
                        <tr>
                            <td>@car.Name</td>
                            <td>@car.FuelType?.Name</td>
                            <td>@car.Category?.Name</td>
                            <td>€ @car.Price.ToString("N2")</td>
                            <td>
                                <a asp-controller="Car" asp-action="Details" asp-route-id="@car.Id" class="btn btn-outline-info btn-sm">Details</a>
                                <a asp-controller="Car" asp-action="Edit" asp-route-id="@car.Id" class="btn btn-outline-warning btn-sm">Wijzig</a>
                                <a asp-controller="Car" asp-action="Delete" asp-route-id="@car.Id" class="btn btn-outline-danger btn-sm">Verwijder</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Statistieken -->
        <h5 class="mb-3">Statistieken</h5>
        <div class="bg-dark p-4 rounded shadow-sm">
            <canvas id="carStatsChart" style="height: 350px;"></canvas>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const ctx = document.getElementById('carStatsChart').getContext('2d');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: ['Mercedes-Benz', 'Audi', 'BMW', 'Tesla'],
            datasets: [{
                label: 'Aantal auto\'s per merk',
                data: [12, 19, 3, 5],
                backgroundColor: ['#bb0a1e', '#0d6efd', '#28a745', '#ffc107']
            }]
        },
        options: {
            responsive: true,
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });
</script>
