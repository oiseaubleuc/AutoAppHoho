@model IEnumerable<AutoAppHoho.Models.Car>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<div class="mb-3">
    <a asp-controller="Car" asp-action="Create" class="btn btn-success">
        @Localizer["AddNewCar"]
    </a>
</div>

<div class="container mt-4">
    <h2 class="text-center fw-bold">@Localizer["CarOverview"]</h2>

    <form asp-action="Index" method="get" class="row g-3 mb-4">
        <div class="col-md-3">
            <label class="form-label fw-bold">@Localizer["FuelTypeLabel"]</label>
            <select class="form-select" name="fuelTypeId">
                <option value="">@Localizer["All"]</option>
                @foreach (var type in ViewBag.FuelTypes)
                {
                    <option value="@type.Id">@type.Name</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label fw-bold">@Localizer["CategoryLabel"]</label>
            <select class="form-select" name="categoryId">
                <option value="">@Localizer["All"]</option>
                @foreach (var cat in ViewBag.Categories)
                {
                    <option value="@cat.Id">@cat.Name</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label fw-bold">@Localizer["MinPriceLabel"]</label>
            <input type="number" class="form-control" name="minPrice" placeholder="0">
        </div>

        <div class="col-md-2">
            <label class="form-label fw-bold">@Localizer["MaxPriceLabel"]</label>
            <input type="number" class="form-control" name="maxPrice" placeholder="50000">
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">@Localizer["FilterButton"]</button>
        </div>
    </form>

    <div class="mb-3">
        <input type="text" id="searchInput" class="form-control" placeholder="@Localizer["SearchPlaceholder"]">
    </div>

    <div id="carList" class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
        @foreach (var car in Model)
        {
            <div class="col">
                <a asp-controller="Car" asp-action="Details" asp-route-id="@car.Id" class="text-decoration-none text-dark">
                    <div class="card car-tile h-100 shadow-sm border-0">
                        <img src="@(string.IsNullOrEmpty(car.ImagePath) ? "/images/no-image.png" : car.ImagePath)" class="card-img-top rounded-top" alt="@car.Name" style="object-fit: cover; height: 180px;">
                        <div class="card-body px-3 pt-3 pb-1">
                            <h6 class="fw-bold mb-1">@car.Name</h6>
                            <p class="text-muted small mb-0">@car.FuelType?.Name | @car.Category?.Name</p>
                            <p class="fw-semibold mb-0 text-dark">
                                àpd <span class="text-primary">@car.Price.ToString("0")€</span> <span class="text-muted">(htva)/mois</span>
                            </p>
                        </div>
                        <div class="card-footer bg-white border-0 d-flex justify-content-center pb-3">
                            <div class="dot"></div>
                            <div class="dot"></div>
                            <div class="dot"></div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<style>
    .car-tile {
        border-radius: 15px;
        transition: transform 0.3s ease-in-out;
        overflow: hidden;
        background-color: #ffffff;
    }

        .car-tile:hover {
            transform: translateY(-5px);
        }

        .car-tile .card-img-top {
            border-top-left-radius: 15px;
            border-top-right-radius: 15px;
            object-fit: cover;
        }

    .dot {
        width: 6px;
        height: 6px;
        background-color: #333;
        border-radius: 50%;
        margin: 0 3px;
        opacity: 0.6;
    }
</style>

<script>
    $(document).ready(function () {
        $("#searchInput").keyup(function () {
            let searchText = $(this).val();
            $.ajax({
                url: "/Car/Search",
                type: "GET",
                data: { search: searchText },
                success: function (data) {
                    let carList = $("#carList");
                    carList.html("");
                    data.forEach(car => {
                        carList.append(`
                                <div class="col">
                                    <a href="/Car/Details/${car.id}" class="text-decoration-none text-dark">
                                        <div class="card car-tile h-100 shadow-sm border-0">
                                            <img src="${car.imagePath ? car.imagePath : '/images/no-image.png'}" class="card-img-top rounded-top" style="object-fit: cover; height: 180px;">
                                            <div class="card-body px-3 pt-3 pb-1">
                                                <h6 class="fw-bold mb-1">${car.name}</h6>
                                                <p class="text-muted small mb-0">${car.fuelType} | ${car.category}</p>
                                                <p class="fw-semibold mb-0 text-dark">
                                                     <span class="text-primary">${car.price}€</span>
                                                </p>
                                            </div>
                                            <div class="card-footer bg-white border-0 d-flex justify-content-center pb-3">
                                                <div class="dot"></div>
                                                <div class="dot"></div>
                                                <div class="dot"></div>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            `);
                    });
                }
            });
        });
    });
</script>
