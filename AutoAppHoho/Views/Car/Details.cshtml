@model AutoAppHoho.Models.Car
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<section class="container my-5">
    <div class="row">
        <!-- Afbeelding links -->
        <div class="col-lg-6 mb-4">
            <img src="@(!string.IsNullOrEmpty(Model.ImagePath) ? Model.ImagePath : "/images/no-image.png")"
                 alt="@Model.Name"
                 class="img-fluid rounded shadow"
                 style="object-fit: cover; width: 100%; height: auto;" />
        </div>

        <!-- Informatie rechts -->
        <div class="col-lg-6 d-flex flex-column justify-content-between">
            <div>
                <h1 class="fw-bold">@Model.Name</h1>
                <p class="lead text-muted">@Model.Category?.Name</p>
                <p class="h4 text-primary fw-semibold mb-4">€@Model.Price.ToString("0") <span class="text-muted fs-6">(htva)/maand</span></p>

                <h5 class="fw-bold mb-3">Caractéristiques :</h5>
                <div class="row mb-3">
                    <div class="col-6"><strong>Année :</strong> @Model.Year</div>
                    <div class="col-6"><strong>Type de carburant :</strong> @Model.FuelType?.Name</div>
                    <div class="col-6"><strong>Catégorie :</strong> @Model.Category?.Name</div>
                    <div class="col-6"><strong>Localisation :</strong> @Model.Location</div>
                    <div class="col-6"><strong>Vues :</strong> @Model.Views</div>
                </div>

                <p class="text-muted">@Model.Description</p>
            </div>

            <div>
                <a asp-action="Index" class="btn btn-outline-secondary mt-4">← @Localizer["BackToList"]</a>
            </div>
        </div>
    </div>
</section>
